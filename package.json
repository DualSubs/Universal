{
	"name": "@dualsubs/universal",
	"organizationName": "🍿️ DualSubs",
	"displayName": "🍿️ DualSubs: 🔣 Universal",
	"description": "流媒体平台字幕增强及双语模块\n如需恢复TV完整支持\n请配合“ iRingo: 📺 TV”使用",
	"homepage": "https://DualSubs.github.io/guide/universal",
	"openUrl": "https://dualsubs.github.io/settings/",
	"icon": "https://github.com/DualSubs/Universal/raw/main/src/assets/icon_rounded.png",
	"keywords": [],
	"contributors": [
		"VirgilClyne[https://github.com/VirgilClyne]"
	],
	"system": [
		"iOS",
		"iPadOS",
		"macOS",
		"tvOS"
	],
	"systemVersion": 15,
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/DualSubs/Universal.git"
	},
	"directories": {
		"example": "example"
	},
	"scripts": {
		"dev": "BUILD_VERSION=dev.$(git rev-parse --short HEAD) sh -c 'npm run clean && npm run build:dev-args && npm run build:dev'",
		"build": "npm run clean && npm run build:args && npm run build:scripts",
		"build:dev": "rollup -c rollup.dev.config.mjs",
		"build:dev-args": "arguments-builder build -c arguments-builder.dev.config.ts && test -s dist/DualSubs.Universal.dev.yaml && node scripts/prepare-preference-panes.mjs --dev",
		"build:release-args": "arguments-builder build -c arguments-builder.release.config.ts && test -s dist/DualSubs.Universal.yaml",
		"build:full-args": "arguments-builder boxjs -c arguments-builder.full.config.ts && node scripts/prepare-preference-panes.mjs",
		"build:args": "npm run build:release-args && npm run build:full-args",
		"dts": "arguments-builder dts -c arguments-builder.full.config.ts",
		"submodule": "git submodule update --remote",
		"test": "node --test tests/*.test.mjs",
		"clean": "node --input-type=module -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true });'",
		"build:scripts": "rollup -c",
		"check:args": "tsc --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --allowImportingTsExtensions arguments-builder.*.config.ts"
	},
	"browserslist": [
		"iOS >= 15"
	],
	"devDependencies": {
		"@nsnanocat/arguments-builder": "^1.8.6",
		"@protobuf-ts/plugin": "^2.11.1",
		"rollup": "4.63.1",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.0",
		"typescript": "^5.9.3",
		"@rollup/plugin-commonjs": "29.0.3"
	},
	"dependencies": {
		"@nsnanocat/url": "^1.2.6",
		"@nsnanocat/util": "^2.7.6",
		"@nsnanocat/xml": "^0.4.4",
		"@protobuf-ts/runtime": "^2.11.1",
		"crypto-js": "^4.2.0",
		"text-encoding": "^0.7.0"
	},
	"overrides": {
		"@nsnanocat/surge2egern": {
			"puppeteer": "25.7.0"
		}
	}
}
